<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <TextView
                android:id="@+id/gamma_title"
                style="@style/Theme.VLC.BottomSheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="@string/gamma_setting"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/gamma_explanation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:text="@string/gamma_explanation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/gamma_title" />

        <TextView
                android:id="@+id/gamma_min_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:text="0.50"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/gamma_seek"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/gamma_seek" />

        <TextView
                android:id="@+id/gamma_max_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:text="2.00"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/gamma_seek"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/gamma_seek" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_gamma_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/round_border"
                android:contentDescription="@string/talkback_decrease_gamma"
                android:focusable="true"
                android:padding="12dp"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/gamma_min_label"
                app:layout_constraintTop_toBottomOf="@+id/gamma_explanation"
                app:srcCompat="@drawable/ic_chevron_left" />

        <TextView
                android:id="@+id/gamma_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.00"
                android:textAlignment="center"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/button_gamma_minus"
                app:layout_constraintEnd_toStartOf="@+id/button_gamma_plus"
                app:layout_constraintStart_toEndOf="@+id/button_gamma_minus"
                app:layout_constraintTop_toTopOf="@+id/button_gamma_minus" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_gamma_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/round_border"
                android:contentDescription="@string/talkback_increase_gamma"
                android:focusable="true"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="@+id/gamma_max_label"
                app:layout_constraintTop_toTopOf="@+id/button_gamma_minus"
                app:srcCompat="@drawable/ic_chevron_right" />

        <SeekBar
                android:id="@+id/gamma_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:max="150"
                android:maxHeight="@dimen/seekbar_height"
                android:minHeight="@dimen/seekbar_height"
                android:progress="50"
                android:progressDrawable="?attr/audio_seek_bar"
                android:splitTrack="false"
                android:thumb="@drawable/ic_seekbar_thumb_audio"
                app:layout_constraintEnd_toStartOf="@+id/gamma_max_label"
                app:layout_constraintStart_toEndOf="@+id/gamma_min_label"
                app:layout_constraintTop_toBottomOf="@+id/button_gamma_minus" />

        <TextView
                android:id="@+id/button_gamma_07"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/round_border"
                android:focusable="true"
                android:gravity="center"
                android:text="0.7"
                app:layout_constraintEnd_toStartOf="@+id/button_gamma_1"
                app:layout_constraintStart_toStartOf="@+id/gamma_seek"
                app:layout_constraintTop_toTopOf="@+id/button_gamma_1" />

        <TextView
                android:id="@+id/button_gamma_1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/round_border"
                android:focusable="true"
                android:gravity="center"
                android:text="1.0"
                app:layout_constraintEnd_toStartOf="@+id/button_gamma_13"
                app:layout_constraintStart_toEndOf="@+id/button_gamma_07"
                app:layout_constraintTop_toBottomOf="@+id/gamma_seek"
                app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
                android:id="@+id/button_gamma_13"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/round_border"
                android:focusable="true"
                android:gravity="center"
                android:text="1.3"
                app:layout_constraintEnd_toStartOf="@+id/button_gamma_16"
                app:layout_constraintStart_toEndOf="@+id/button_gamma_1"
                app:layout_constraintTop_toTopOf="@+id/button_gamma_1" />

        <TextView
                android:id="@+id/button_gamma_16"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/round_border"
                android:focusable="true"
                android:gravity="center"
                android:text="1.6"
                app:layout_constraintEnd_toEndOf="@+id/gamma_seek"
                app:layout_constraintStart_toEndOf="@+id/button_gamma_13"
                app:layout_constraintTop_toTopOf="@+id/button_gamma_1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
